# AuraFlow Web — configuration
#
# CANONICAL_BASE_URL
# The canonical origin (+ optional subpath) of the deployed site.
# Used for: canonical <link>, Open Graph URLs, sitemap.xml, robots.txt.
#
# Production (Vercel) — also the built-in default, so this is optional there:
CANONICAL_BASE_URL=https://online-file-organizer.vercel.app/
#
# GitHub Pages (project site) override:
# BASE=/File-Organizer-Web/
# CANONICAL_BASE_URL=https://heyitssuzain.github.io/File-Organizer-Web/
#
# Custom domain override:
# CANONICAL_BASE_URL=https://example.com/
#
# BASE (Vite public base path — must match the subpath above)
# For Vercel / a custom domain at the root, set BASE=/.
# For GitHub Pages project sites, set BASE=/File-Organizer-Web/.
BASE=/
